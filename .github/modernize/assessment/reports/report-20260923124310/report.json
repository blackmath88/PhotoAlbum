  "rules": {
    "Scale.0001": {
      "id": "Scale.0001",
      "description": "Statischer Inhalt erkannt.\n\nIhr aktueller Ansatz f\u00FCr die direkte Bereitstellung statischer Inhalte kann zu erh\u00F6hten Kosten, Leistungsproblemen, Wartungsproblemen (eine erneute Anwendungsbereitstellung f\u00FCr Inhalts\u00E4nderungen) und Sicherheitsrisiken f\u00FChren.\n\nErw\u00E4gen Sie, statische Inhalte in Azure Blob Storage zu verschieben und Azure CDN hinzuzuf\u00FCgen.",
      "title": "Statischer Inhalt erkannt",
      "severity": "optional",
      "effort": 3,
      "links": [
        {
          "title": "Azure Blob Storage",
          "url": "https://go.microsoft.com/fwlink/?linkid=2250574"
        },
        {
          "title": "Azure\u00A0CDN",
          "url": "https://go.microsoft.com/fwlink/?linkid=2250392"
        }
      ],
      "labels": []
    },
    "Database.0002": {
      "id": "Database.0002",
      "description": "SQL-Datenbankverbindung erkannt.\n\nStellen Sie sicher, dass die Datenbank in Azure verf\u00FCgbar/erreichbar ist.\n\nFalls nicht, gibt es mehrere M\u00F6glichkeiten, um Ihre Daten nach Azure zu verschieben:\n    1. Migrieren Sie zu Azure SQL-Datenbank.\n    2. Erw\u00E4gen Sie Azure SQL Managed Instance, wenn Sie Features ben\u00F6tigen, die in Azure SQL-Datenbank nicht verf\u00FCgbar sind und Sie keine VM verwenden m\u00F6chten.\n    3. Migrieren Sie Ihre Datenbankserver direkt zu SQL Server auf Azure-VMs.\n\nUm den Aufwand f\u00FCr die Datenbankmigration zu bewerten, k\u00F6nnen Sie das Azure Migrate-Tool verwenden, siehe Link unten.",
      "title": "SQL-Datenbankverbindung erkannt",
      "severity": "potential",
      "effort": 3,
      "links": [
        {
          "title": "SQL Server-Datenbank zu Azure migrieren",
          "url": "https://go.microsoft.com/fwlink/?LinkID=2251731"
        },
        {
          "title": "Azure SQL Managed Instance",
          "url": "https://go.microsoft.com/fwlink/?LinkID=2251613"
        },
        {
          "title": "Azure Migrate",
          "url": "https://go.microsoft.com/fwlink/?linkid=2252410"
        }
      ],
      "labels": []
    },
    "Identity.0002": {
      "id": "Identity.0002",
      "description": "Ihre App verwendet die Windows-Authentifizierung, die auf Azure App Service, Azure Container Apps und Azure Kubernetes Service nicht unterst\u00FCtzt wird.\n\nAzure App Service bietet integrierte Authentifizierungs- und Autorisierungsfunktionen, sodass sich Benutzer anmelden und auf Daten zugreifen k\u00F6nnen, indem Sie minimalen oder gar keinen Code in Ihre Web-App schreiben.\n\nFolgen Sie dem Link unten, um weitere Informationen zu erfahren.",
      "title": "Windows-Authentifizierung erkannt",
      "severity": "mandatory",
      "effort": 3,
      "links": [
        {
          "url": "https://go.microsoft.com/fwlink/?LinkID=2242883"
        }
      ],
      "labels": []
    },
    "Security.0002": {
      "id": "Security.0002",
      "description": "Verbindungszeichenfolgen ohne Konfigurations-Generatoren erkannt.  \n\n Das direkte Aufbewahren von Verbindungszeichenfolgen in der App ist keine bew\u00E4hrte Methode und kann zu Sicherheitsrisiken, erh\u00F6hten Wartungsarbeiten, Skalierbarkeitsproblemen oder Konformit\u00E4tsstandards f\u00FChren (z.\u00A0B. PCI-DSS, DSGVO usw.). \n\n Es wird stattdessen empfohlen, Konfigurations-Generatoren zum Abrufen von Geheimnissen aus sicheren Quellen in der Azure-Umgebung zu verwenden.",
      "title": "Verbindungszeichenfolgen ohne Konfigurations-Generatoren erkannt",
      "severity": "optional",
      "effort": 3,
      "links": [
        {
          "title": "Konfigurations-Generatoren",
          "url": "https://go.microsoft.com/fwlink/?LinkID=2250915"
        },
        {
          "title": "Anwendungsgeheimnisse werden gespeichert",
          "url": "https://go.microsoft.com/fwlink/?LinkID=2250916"
        },
        {
          "title": "Zentralisierte App-Konfiguration und -Sicherheit",
          "url": "https://go.microsoft.com/fwlink/?LinkID=2250733"
        }
      ],
      "labels": []
    },
    "Configuration.0003": {
      "id": "Configuration.0003",
      "description": "Local application configuration detected. Azure App Configuration can be used as a centralized, cloud-based service for application settings that are currently stored in local configuration files. Moving this configuration to Azure App Configuration can help you externalize settings from code and deployment artifacts, centralize management across environments, and enable dynamic refresh and controlled access to configuration data.",
      "title": "Local application configuration detected",
      "severity": "potential",
      "effort": 1,
      "links": [
        {
          "title": "What is Azure App Configuration?",
          "url": "https://learn.microsoft.com/azure/azure-app-configuration/overview"
        },
        {
          "title": "Configuration management with Azure App Configuration",
          "url": "https://aka.ms/appconfig/configuration-management"
        }
      ],
      "labels": []
    },
    "Connection.0001": {
      "id": "Connection.0001",
      "description": "Verbindungszeichenfolge erkannt. M\u00F6glicherweise ist sie nicht verf\u00FCgbar, wenn Ihre App zu Azure migriert wird.\n\n\u00DCberpr\u00FCfen Sie dies, und stellen Sie sicher, dass sie \u00FCber Azure funktioniert. Wenn Sie eine Verbindung mit einer Datenbank herstellen, m\u00FCssen Sie die Datenbank m\u00F6glicherweise zu Azure migrieren. Daf\u00FCr gibt es mehrere M\u00F6glichkeiten:\n    1. Migrieren Sie zu Azure SQL-Datenbank, um zus\u00E4tzliche Vorteile zu nutzen (siehe Link unten).\n    2. Erw\u00E4gen Sie Azure SQL Managed Instance, wenn Sie Features ben\u00F6tigen, die in Azure SQL-Datenbank nicht verf\u00FCgbar sind und Sie keine VM verwenden m\u00F6chten.\n    3. Migrieren Sie Ihre Datenbankserver direkt zu SQL Server auf Azure-VMs.\n\nUm den Aufwand f\u00FCr die Datenbankmigration zu bewerten, k\u00F6nnen Sie das Azure Migrate-Tool verwenden, siehe Link unten.",
      "title": "Verbindungszeichenfolge wurde erkannt",
      "severity": "potential",
      "effort": 3,
      "links": [
        {
          "title": "SQL Server-Datenbank zu Azure migrieren",
          "url": "https://go.microsoft.com/fwlink/?LinkID=2251731"
        },
        {
          "title": "Azure SQL Managed Instance",
          "url": "https://go.microsoft.com/fwlink/?LinkID=2251613"
        },
        {
          "title": "Azure Migrate",
          "url": "https://go.microsoft.com/fwlink/?linkid=2252410"
        }
      ],
      "labels": []
    },
    "Local.0003": {
      "id": "Local.0003",
      "description": "Ihre Anwendung verf\u00FCgt \u00FCber lokale oder Netzwerk-E/A-Vorg\u00E4nge.\n\nWenn Sie verwaltete Instanz auf Azure App Service als Ziel verwenden, verlagern Sie persistente E/A auf Storage-Mounts (Azure Files/UNC). Beschr\u00E4nken Sie lokale Schreibvorg\u00E4nge auf tempor\u00E4re Daten. Verbinden Sie sich mit externen Abh\u00E4ngigkeiten \u00FCber private Endpunkte/VNet, um Latenz zu reduzieren.\n\nE/A-Vorg\u00E4nge au\u00DFerhalb des Anwendungsordners sind auf Azure App Service m\u00F6glicherweise nicht verf\u00FCgbar. \u00DCberpr\u00FCfen Sie dies, und stellen Sie sicher, dass E/A-APIs versuchen, auf Pfade zuzugreifen, die verf\u00FCgbar sind, wenn Ihre App in der App Service-Sandbox ausgef\u00FChrt wird. Wenn Sie die Containerhostingoption ausw\u00E4hlen, ist Ihr Szenario m\u00F6glicherweise weiterhin fehlerhaft oder weist Skalierbarkeitsprobleme auf.\n\nM\u00F6gliche L\u00F6sungen:\n    1. Dateien, die die Anwendung ben\u00F6tigt, k\u00F6nnen mit der Anwendung bereitgestellt oder in Azure Storage abgelegt werden. Sie k\u00F6nnen Azure Storage-Dateifreigaben als Drop-In-Ersatz f\u00FCr die lokale Dateifreigabe verwenden.\n    2. Andere Dienste, von denen die Anwendung abh\u00E4ngt, m\u00FCssen m\u00F6glicherweise zu Azure migriert werden. Auf diese Weise profitieren Sie von einer geringeren Latenz in der Cloud.\n    3. Wenn Ihre Anwendung von Diensten abh\u00E4ngig ist, die lokal ausgef\u00FChrt werden, k\u00F6nnen Sie Ihre lokalen und Azure-Netzwerke mit ExpressRoute, Hybridverbindungen oder VPN-L\u00F6sungen verbinden.",
      "title": "Es wurden lokale oder Netzwerk-E/A-Vorg\u00E4nge erkannt.",
      "severity": "potential",
      "effort": 3,
      "links": [
        {
          "title": "[Verwaltete Instanz] Speicherbereitstellungen",
          "url": "https://go.microsoft.com/fwlink/?linkid=2346952"
        },
        {
          "title": "Azure-Dateifreigabe",
          "url": "https://go.microsoft.com/fwlink/?LinkID=2242591"
        },
        {
          "title": "ExpressRoute",
          "url": "https://go.microsoft.com/fwlink/?LinkID=2250577"
        },
        {
          "title": "Hybridverbindungen",
          "url": "https://go.microsoft.com/fwlink/?LinkID=2242588"
        },
        {
          "title": "Lokales Netzwerk verbinden",
          "url": "https://go.microsoft.com/fwlink/?LinkID=2242591"
        },
        {
          "title": "Entwurf f\u00FCr Aufskalieren",
          "url": "https://go.microsoft.com/fwlink/?linkid=2251007"
        }
      ],
      "labels": []
    },
    "Security.0003": {
      "id": "Security.0003",
      "description": "Hartcodierte vertrauliche Daten erkannt.\n\nWenn Sie die Verwaltete Instanz f\u00FCr Azure App Service als Ziel verwenden, lagern Sie Geheimnisse in Azure Key Vault oder Azure App Configuration aus. Verwenden Sie eine verwaltete Identit\u00E4t anstelle von Kennw\u00F6rtern oder eingebetteten Verbindungszeichenfolgen.\n\nWenn Sie hingegen andere Azure-Computedienste als Ziel verwenden:\n\nVermeiden Sie es, vertrauliche Daten wie Kennw\u00F6rter, IDs, Token usw. direkt in Konfigurationsdateien und Code zu platzieren, da dies die Sicherheit Ihrer Anwendung beeintr\u00E4chtigt.\n\nVerwenden Sie Azure App Configuration oder Azure Key Vault zum Speichern von Geheimnissen.",
      "title": "Hartcodierte vertrauliche Daten erkannt",
      "severity": "optional",
      "effort": 3,
      "links": [
        {
          "title": "Zentralisierte App-Konfiguration und -Sicherheit",
          "url": "https://go.microsoft.com/fwlink/?LinkID=2250733"
        }
      ],
      "labels": []
    }
  }
